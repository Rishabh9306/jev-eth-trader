# TypeSafe AI Jev Credentials
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-latest

# Trading Configuration
TRADING_MODE=paper               # "paper" for simulated execution, "live" for exchange execution
TRADING_PAIR=ETH/USDT
TIMEFRAME=5m                     # OHLCV bar timeframe (e.g., 1m, 5m, 15m, 1h)
CYCLE_INTERVAL_SECONDS=60        # Seconds between decision cycles

# Capital & Position Sizing
INITIAL_PAPER_BALANCE_USDT=10000.0
POSITION_SIZE_PCT=0.10           # Fraction of total equity allocated per trade (e.g., 0.10 = 10%)
MAX_OPEN_POSITIONS=1

# Risk Management & Confidence Thresholds
MIN_CONFIDENCE_THRESHOLD=0.70    # Minimum Jev decision confidence (0.0 to 1.0) required to open a trade
MAX_RISK_SCORE=1.5               # Maximum allowable Jev risk score (0 to 3 scale)
MIN_ENTRY_CONVICTION=0.65        # Minimum Noul probability required to enter a position
EXIT_URGENCY_THRESHOLD=0.75      # Noul probability threshold to trigger emergency liquidation

# Stop Loss & Take Profit
STOP_LOSS_PCT=0.025              # 2.5% fixed stop loss floor if ATR is not used
TAKE_PROFIT_PCT=0.050            # 5.0% take profit target
USE_ATR_STOP=True                # Use dynamic ATR multiplier for stop loss
ATR_MULTIPLIER=1.8               # ATR multiplier for dynamic stop loss
MAX_DAILY_DRAWDOWN_PCT=0.06      # Max 6% daily drawdown circuit breaker

# Simulated Fee & Slippage (Paper Trading)
SLIPPAGE_BPS=5.0                 # Simulated slippage: 5 basis points (0.05%)
FEE_BPS=5.0                      # Simulated taker fee: 5 basis points (0.05%)
